", "@CODIGO-INSTITUICAO-OUTRA-SANDUICHE": "", "@CODIGO-INSTITUICAO-SANDUICHE": "", "@NOME-DO-CO-ORIENTADOR": "", "@STATUS-OASISBR": "", "@ID-OASIS": "", "AREAS-DO-CONHECIMENTO": {"AREA-DO-CONHECIMENTO-1": {"@NOME-GRANDE-AREA-DO-CONHECIMENTO": "ENGENHARIAS", "@NOME-DA-AREA-DO-CONHECIMENTO": "", "@NOME-DA-SUB-AREA-DO-CONHECIMENTO": "sensores", "@NOME-DA-ESPECIALIDADE": ""}}}}, "ATUACOES-PROFISSIONAIS": {"ATUACAO-PROFISSIONAL": [{"@CODIGO-INSTITUICAO": "033700000000", "@NOME-INSTITUICAO": "Universidade Federal do Rio Grande do Norte", "@SEQUENCIA-ATIVIDADE": "1", "@SEQUENCIA-IMPORTANCIA": "", "VINCULOS": {"@SEQUENCIA-HISTORICO": "1", "@TIPO-DE-VINCULO": "LIVRE", "@ENQUADRAMENTO-FUNCIONAL": "LIVRE", "@CARGA-HORARIA-SEMANAL": "", "@FLAG-DEDICACAO-EXCLUSIVA": "NAO", "@MES-INICIO": "04", "@ANO-INICIO": "2012", "@MES-FIM": "01", "@ANO-FIM": "2013", "@OUTRAS-INFORMACOES": "O projeto de monitoria do Curso de Ciências e Tecnologia (Bacharelado) da UFRN, tinha como objetivo apoiar a tarefa docente nas suas diversas instâncias. Ele estava interligado com docentes, monitores e bolsistas pós-graduandos de docência assistida &#10;nas áreas da componente curricular: Ciências, tecnologia e sociedade. Esse projeto recebeu turmas da ordem de 150 alunos no qual, o monitor, assim como os demais participantes, tinha a importante função de auxiliar os alunos em um melhor desenvolvimento acadêmico.", "@FLAG-VINCULO-EMPREGATICIO": "SIM", "@OUTRO-VINCULO-INFORMADO": "Bolsista", "@OUTRO-ENQUADRAMENTO-FUNCIONAL-INFORMADO": "Projeto de Monitoria", "@OUTRO-ENQUADRAMENTO-FUNCIONAL-INFORMADO-INGLES": "", "@OUTRAS-INFORMACOES-INGLES": ""}, "ATIVIDADES-DE-PARTICIPACAO-EM-PROJETO": {"PARTICIPACAO-EM-PROJETO": [{"@SEQUENCIA-FUNCAO-ATIVIDADE": "1", "@FLAG-PERIODO": "ANTERIOR", "@MES-INICIO": "", "@ANO-INICIO": "2013", "@MES-FIM": "", "@ANO-FIM": "2013", "@CODIGO-ORGAO": "033701000992", "@NOME-ORGAO": "Escola de Ciências e Tecnologia", "@CODIGO-UNIDADE": "", "@NOME-UNIDADE": "", "PROJETO-DE-PESQUISA": {"@SEQUENCIA-PROJETO": "1", "@ANO-INICIO": "2013", "@ANO-FIM": "2013", "@NOME-DO-PROJETO": "Desenvolvimento de Compósitos de Matriz Polimérica com Incorporação de Resíduos de Placas de Circuito Impresso", "@SITUACAO": "DESATIVADO", "@NATUREZA": "PESQUISA", "@NUMERO-GRADUACAO": "", "@NUMERO-ESPECIALIZACAO": "", "@NUMERO-MESTRADO-ACADEMICO": "", "@NUMERO-MESTRADO-PROF": "", "@NUMERO-DOUTORADO": "", "@DESCRICAO-DO-PROJETO": "A proposta do presente projeto é utilizar a fração não-metálica de placas de circuito impresso beneficiada como carga em compósitos termorígidos. Para tanto, são definidos os seguintes objetivos específicos:&#10;1)Caracterizar química e fisicamente as placas de circuito impresso de computadores descartados;&#10;2)Desenvolver rotas para separar fisicamente a fração metálica, da não-metálica;&#10;3)Realizar a caracterização ambiental dos resíduos provenientes do processamento das placas de circuito impresso;&#10;4)Estudar a mistura a ser considerada;&#10;5)Estudar as propriedades mecânicas do compósito considerado em laboratório;&#10;6)Aplicar um planejamento experimental para obtenção de um modelo estatístico visando descrever, com base nas evidências experimentais, o comportamento do processo estudado;&#10;7)Analisar a viabilidade econômica da comercialização do compósito", "@IDENTIFICADOR-PROJETO": "", "@DESCRICAO-DO-PROJETO-INGLES": "", "@NOME-DO-PROJETO-INGLES": "", "@FLAG-POTENCIAL-INOVACAO": "SIM", "@NOME-COORDENADOR-CERTIFICACAO": "", "@DATA-CERTIFICACAO": "", "@NUMERO_TECNICO_NIVEL_MEDIO": "", "EQUIPE-DO-PROJETO": {"INTEGRANTES-DO-PROJETO": [{"@NOME-COMPLETO": "Guilherme Henrique de Melo Gurgel", "@NOME-PARA-CITACAO": "GURGEL, G. H. M.;G. M. Gurgel;Gurgel, G. M.;GURGEL, G.M.;Gurgel, GHM", "@ORDEM-DE-INTEGRACAO": "1", "@FLAG-RESPONSAVEL": "SIM", "@NRO-ID-CNPQ": "2421927797042514"}, {"@NOME-COMPLETO": "Luciana de Figueiredo Lopes Lucena", "@NOME-PARA-CITACAO": "LUCENA, L. F. L.", "@ORDEM-DE-INTEGRACAO": "2", "@FLAG-RESPONSAVEL": "NAO", "@NRO-ID-CNPQ": ""}]}}}, {"@SEQUENCIA-FUNCAO-ATIVIDADE": "2", "@FLAG-PERIODO": "ANTERIOR", "@MES-INICIO": "", "@ANO-INICIO": "2017", "@MES-FIM": "", "@ANO-FIM": "2017", "@CODIGO-ORGAO": "033710000002", "@NOME-ORGAO": "Centro de Tecnologia", "@CODIGO-UNIDADE": "", "@NOME-UNIDADE": "", "PROJETO-DE-PESQUISA": [{"@SEQUENCIA-PROJETO": "4", "@ANO-INICIO": "2017", "@ANO-FIM": "2017", "@NOME-DO-PROJETO": "Síntese e caracterização de molibdatos de cálcio e bário pelo método hidrotérmico de micro ondas.", "@SITUACAO": "CONCLUIDO", "@NATUREZA": "PESQUISA", "@NUMERO-GRADUACAO": "", "@NUMERO-ESPECIALIZACAO": "", "@NUMERO-MESTRADO-ACADEMICO": "", "@NUMERO-MESTRADO-PROF": "", "@NUMERO-DOUTORADO": "", "@DESCRICAO-DO-PROJETO": "? Caracterização dos materiais elaborados via micro ondas&#10;? Elaboração de banners e resumo para publicação em congresso de iniciação cientifica", "@IDENTIFICADOR-PROJETO": "", "@DESCRICAO-DO-PROJETO-INGLES": "", "@NOME-DO-PROJETO-INGLES": "", "@FLAG-POTENCIAL-INOVACAO": "SIM", "@NOME-COORDENADOR-CERTIFICACAO": "", "@DATA-CERTIFICACAO": "", "@NUMERO_TECNICO_NIVEL_MEDIO": "", "EQUIPE-DO-PROJETO": {"INTEGRANTES-DO-PROJETO": [{"@NOME-COMPLETO": "Guilherme Henrique de Melo Gurgel", "@NOME-PARA-CITACAO": "GURGEL, G. H. M.;G. M. Gurgel;Gurgel, G. M.;GURGEL, G.M.;Gurgel, GHM", "@ORDEM-DE-INTEGRACAO": "1", "@FLAG-RESPONSAVEL": "NAO", "@NRO-ID-CNPQ": "2421927797042514"}, {"@NOME-COMPLETO": "BOMIO, M. R. D.", "@NOME-PARA-CITACAO": "BOMIO, M. R. D.", "@ORDEM-DE-INTEGRACAO": "2", "@FLAG-RESPONSAVEL": "SIM", "@NRO-ID-CNPQ": ""}]}}, {"@SEQUENCIA-PROJETO": "2", "@ANO-INICIO": "2017", "@ANO-FIM": "2017", "@NOME-DO-PROJETO": "Síntese e caracterização de molibdatos de cálcio e bário pelo método hidrotérmico de micro ondas.", "@SITUACAO": "CONCLUIDO", "@NATUREZA": "PESQUISA", "@NUMERO-GRADUACAO": "", "@NUMERO-ESPECIALIZACAO": "", "@NUMERO-MESTRADO-ACADEMICO": "", "@NUMERO-MESTRADO-PROF": "", "@NUMERO-DOUTORADO": "", "@DESCRICAO-DO-PROJETO": "Neste projeto estudou-se a sintetização de materiais cerâmicos de molibdato de cálcio (CaMoO4) e molibdato de bário (BaMoO4) e o uso de diferentes surfactantes a partir do método hidrotérmico de micro ondas. A caracterização estrutural dos materiais foi realizada por intermédio da técnica de difração de raios-X e espectroscopias Raman, ultravioleta-visível. Para a caracterização morfológica realizou-se ensaios de microscopia eletrônica de varredura com canhão de elétrons por emissão de campo. &#10;As propriedades ópticas dos materiais foram caracterizadas pela técnica de fotoluminescência e as coordenadas cromáticas foram calculadas pela combinação de cores a partir dos resultados dos espectros de emissão.", "@IDENTIFICADOR-PROJETO": "", "@DESCRICAO-DO-PROJETO-INGLES": "", "@NOME-DO-PROJETO-INGLES": "", "@FLAG-POTENCIAL-INOVACAO": "NAO", "@NOME-COORDENADOR-CERTIFICACAO": "", "@DATA-CERTIFICACAO": "", "@NUMERO_TECNICO_NIVEL_MEDIO": "", "EQUIPE-DO-PROJETO": {"INTEGRANTES-DO-PROJETO": [{"@NOME-COMPLETO": "Guilherme Henrique de Melo Gurgel", "@NOME-PARA-CITACAO": "GURGEL, G. H. M.;G. M. Gurgel;Gurgel, G. M.;GURGEL, G.M.;Gurgel, GHM", "@ORDEM-DE-INTEGRACAO": "1", "@FLAG-RESPONSAVEL": "SIM", "@NRO-ID-CNPQ": "2421927797042514"}, {"@NOME-COMPLETO": "Mauricio Roberto Bomio Delmonde", "@NOME-PARA-CITACAO": "DELMONDE, M. R. B.", "@ORDEM-DE-INTEGRACAO": "2", "@FLAG-RESPONSAVEL": "NAO", "@NRO-ID-CNPQ": ""}]}}]}, {"@SEQUENCIA-FUNCAO-ATIVIDADE": "3", "@FLAG-PERIODO": "ANTERIOR", "@MES-INICIO": "", "@ANO-INICIO": "2015", "@MES-FIM": "", "@ANO-FIM": "2015", "@CODIGO-ORGAO": "033710000002", "@NOME-ORGAO": "Centro de Tecnologia", "@CODIGO-UNIDADE": "", "@NOME-UNIDADE": "", "PROJETO-DE-PESQUISA": {"@SEQUENCIA-PROJETO": "5", "@ANO-INICIO": "2015", "@ANO-FIM": "2015", "@NOME-DO-PROJETO": "Estudo das propriedades físicas, químicas e morfológicas e dos parâmetros de processamento de resíduos de rochas calcárias", "@SITUACAO": "CONCLUIDO", "@NATUREZA": "PESQUISA", "@NUMERO-GRADUACAO": "2", "@NUMERO-ESPECIALIZACAO": "", "@NUMERO-MES