o"}, "AREA-DO-CONHECIMENTO-3": {"@NOME-GRANDE-AREA-DO-CONHECIMENTO": "CIENCIAS_EXATAS_E_DA_TERRA", "@NOME-DA-AREA-DO-CONHECIMENTO": "Ciência da Computação", "@NOME-DA-SUB-AREA-DO-CONHECIMENTO": "Sistemas de Computação", "@NOME-DA-ESPECIALIDADE": ""}}, "INFORMACOES-ADICIONAIS": {"@DESCRICAO-INFORMACOES-ADICIONAIS": "Este trabalho apresenta o desenvolvimento de um sistema de monitoramento do\nconsumo de água utilizando o conceito ?Internet das Coisas?. O sistema possibilita aos\nseus usuários fazer o acompanhamento do seu respectivo consumo de água por meio de\ngráficos disponibilizados através de um sistema web. Este sistema visa modernizar o\ncontrole de consumo de água para melhorar a gestão do recurso hídrico.", "@DESCRICAO-INFORMACOES-ADICIONAIS-INGLES": "The development of a system to water expenditure monitoring using the concept\n?Internet of Things? is shown in this work. The system provides consumers to follow up\ntheir water expenditure through graphics available in a web system and it aims to\nmodernize the control of water expenditure and, consequently, improve water resources\nmanagement."}}}}, "PRODUCAO-TECNICA": null, "OUTRA-PRODUCAO": null, "DADOS-COMPLEMENTARES": {"FORMACAO-COMPLEMENTAR": {"FORMACAO-COMPLEMENTAR-CURSO-DE-CURTA-DURACAO": [{"@SEQUENCIA-FORMACAO": "4", "@NIVEL": "F", "@CARGA-HORARIA": "10", "@CODIGO-INSTITUICAO": "202100000001", "@NOME-INSTITUICAO": "Instituto Nacional de Telecomunicações", "@CODIGO-ORGAO": "", "@NOME-ORGAO": "", "@CODIGO-CURSO": "90000002", "@NOME-CURSO": "Desenvolvimento Básico em Windows Phone", "@STATUS-DO-CURSO": "CONCLUIDO", "@ANO-DE-INICIO": "2014", "@ANO-DE-CONCLUSAO": "2014", "@NOME-CURSO-INGLES": ""}, {"@SEQUENCIA-FORMACAO": "11", "@NIVEL": "F", "@CARGA-HORARIA": "", "@CODIGO-INSTITUICAO": "202100000001", "@NOME-INSTITUICAO": "Instituto Nacional de Telecomunicações", "@CODIGO-ORGAO": "", "@NOME-ORGAO": "", "@CODIGO-CURSO": "90000011", "@NOME-CURSO": "Ericsson Cloud Competence Program", "@STATUS-DO-CURSO": "CON