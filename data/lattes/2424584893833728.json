CIA": "Fundação Instituto Nacional de Telecomunicações", "@CARGA-HORARIA": "400", "@TITULO-DA-MONOGRAFIA-INGLES": "", "@NOME-CURSO-INGLES": ""}, "CURSO-TECNICO-PROFISSIONALIZANTE": {"@SEQUENCIA-FORMACAO": "10", "@NIVEL": "7", "@CODIGO-INSTITUICAO": "000500000999", "@NOME-INSTITUICAO": "Instituto de Pesquisa e Tecnologia Computacional", "@CODIGO-ORGAO": "", "@NOME-ORGAO": "", "@CODIGO-CURSO": "90000010", "@NOME-CURSO": "Técnico em Informática", "@STATUS-DO-CURSO": "CONCLUIDO", "@ANO-DE-INICIO": "2010", "@ANO-DE-CONCLUSAO": "2011", "@FLAG-BOLSA": "NAO", "@CODIGO-AGENCIA-FINANCIADORA": "", "@NOME-AGENCIA": "", "@NOME-CURSO-INGLES": ""}}, "ATUACOES-PROFISSIONAIS": {"ATUACAO-PROFISSIONAL": {"@CODIGO-INSTITUICAO": "202100000001", "@NOME-INSTITUICAO": "Instituto Nacional de Telecomunicações", "@SEQUENCIA-ATIVIDADE": "1", "@SEQUENCIA-IMPORTANCIA": "1", "VINCULOS": [{"@SEQUENCIA-HISTORICO": "1", "@TIPO-DE-VINCULO": "COLABORADOR", "@ENQUADRAMENTO-FUNCIONAL": "LIVRE", "@CARGA-HORARIA-SEMANAL": "40", "@FLAG-DEDICACAO-EXCLUSIVA": "SIM", "@MES-INICIO": "12", "@ANO-INICIO": "2012", "@MES-FIM": "04", "@ANO-FIM": "2016", "@OUTRAS-INFORMACOES": "Desenvolvimento de soluções de software para centrais telefônicas AXE da Ericsson, utilizando\nlinguagens de programação proprietárias da Ericsson. O processo de desenvolvimento\nconsiste em análise, simulação e correção das falhas de software de centrais telefônicas AXE\nEricsson que são reportadas por operadoras de telecomunicações ao redor do mundo. Para\nverificação da solução desenvolvida, são realizados testes em ambiente remoto utilizando\nsimuladores das centrais telefônicas. As atividades são executadas utilizando metodologia ágil.", "@FLAG-VINCULO-EMPREGATICIO": "SIM", "@OUTRO-VINCULO-INFORMADO": "", "@OUTRO-ENQUADRAMENTO-FUNCIONAL-INFORMADO": "Especialista em Sistemas", "@OUTRO-ENQUADRAMENTO-FUNCIONAL-INFORMADO-INGLES": "", "@OUTRAS-INFORMACOES-INGLES": "Development of software solutions for AXE Ericsson telephone exchanges using Ericsson\nprogramming languages. The process of development consists in analysis, simulation and\ndevelopment of solutions to solve the faults reported by telecommunications operators around\nthe world which use the AXE Ericsson telephone exchanges. To assure the quality of solution\ndeveloped are performed tests in a remote environment using simulators of telephone\nexchanges. Whole the process is executed using agile methodology."}, {"@SEQUENCIA-HISTORICO": "2", "@TIPO-DE-VINCULO": "COLABORADOR", "@ENQUADRAMENTO-FUNCIONAL": "LIVRE", "@CARGA-HORARIA-SEMANAL": "40", "@FLAG-DEDICACAO-EXCLUSIVA": "SIM", "@MES-INICIO": "04", "@ANO-INICIO": "2016", "@MES-FIM": "", "@ANO-FIM": "", "@OUTRAS-INFORMACOES": "Atividades relacionadas ao processo de integração em ambientes de nuvem, incluindo operação e suporte.\nManter o sistema SaaS operacional e atualizado para os clientes da Ericsson.\nImplantar atualizações do sistema nos ambientes de nuvem do cliente.\nMonitorar ativamente o sistema SaaS prevendo e resolvendo falhas antes que isso aconteça.\nResolver qualquer possível problema no sistema no menor tempo possível.\nSuporte aos clientes, fornecendo treinamento quando necessário.", "@FLAG-VINCULO-EMPREGATICIO": "SIM", "@OUTRO-VINCULO-INFORMADO": "", "@OUTRO-ENQUADRAMENTO-FUNCIONAL-INFORMADO": "Especialista em Sistemas", "@OUTRO-ENQUADRAMENTO-FUNCIONAL-INFORMADO-INGLES": "", "@OUTRAS-INFORMACOES-INGLES": "Activities related to onboarding process in cloud environments, including operation and\nsupport.\nKeep SaaS operative and updated to Ericsson customers.\nDeploy system releases and updates in customer?s cloud environments.\nMonitor actively the SaaS by predicting and solving faults before it happens.\nSolve any possible issue in SaaS in a shortest time as possible.\nSupport customers by providing training when required."}]}}, "AREAS-DE-ATUACAO": {"AREA-DE-ATUACAO": [{"@SEQUENCIA-AREA-DE-ATUACAO": "1", "@NOME-GRANDE-AREA-DO-CONHECIMENTO": "CIENCIAS_EXATAS_E_DA_TERRA", "@NOME-D